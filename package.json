{
  "name": "wjwang.dev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "pnpm build:articles && pnpm -r build",
    "preview": "pnpm --filter web exec serve out -p 3000 -L",
    "build:articles": "tsx scripts/build-articles.ts",
    "new:article": "tsx scripts/new-article.ts",
    "validate:article": "tsx scripts/validate-article.ts",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "dependencies": {
    "@wjwang/ui": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.5",
    "chokidar": "^5.0.0",
    "feed": "^5.2.1",
    "globby": "^16.2.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.5",
    "yaml": "^2.8.4",
    "zod": "^3.23.8"
  }
}
